# Local environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store

# The source paper is copyrighted (Elsevier) - must never be committed.
*.pdf
!report/build/*.pdf

# Data, embeddings and checkpoints live in $WORK on the cluster, never in git.
/data/
/embeddings/
/checkpoints/
*.npy
*.npz
*.pth
*.pt

# Slurm job noise. The directory itself is tracked: sbatch writes into it
# and Slurm fails a job that cannot open its output file.
slurm-*.out
/logs/*
!/logs/.gitkeep

# Results: the aggregated CSVs ARE committed (every figure is regenerable from
# them); only the per-mask raw dumps are excluded.
/results/raw/
